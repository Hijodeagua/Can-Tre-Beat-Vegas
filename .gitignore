# Python
# These are setuptools/distutils build directories, which only ever appear at
# the repo root — so they are anchored with a leading slash. Unanchored, `lib/`
# matches a directory named lib at ANY depth, which silently swallowed
# web/app/lib/data.ts and broke the Vercel build with a module-not-found that
# looked like a missing file rather than a gitignore rule.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local development
*.local
.env

# SoFIFA raw squad cache (resume support; regenerated by sofifa_client)
soccer/data/fifa_ratings/.cache/

# Retrosheet raw downloads (reproducible via mlb/build_games.py)
data/mlb/raw_gamelogs/
mlb/__pycache__/

# nflverse raw roster/stat downloads (regenerated by data_jobs.rosters.fetch_nflverse;
# only the aggregated data/rosters/squad_features.csv is committed)
data/rosters/nflverse/
# Cached award pages from the local-only PFR/Wikipedia scrape
data/rosters/awards/raw/

# Understat raw league JSON (regenerated by soccer.clubs.data.understat;
# the processed understat_matches.csv is what's committed)
data/soccer_clubs/raw/
# nflverse play-by-play parquet cache (regenerated by NFL.data.fetch_pbp;
# ~20 MB a season, the team-game aggregate table is what's committed)
data/nfl/raw/
# sportsdataverse weekly CFB summaries cache (regenerated by
# CFB.data.fetch_weekly; the trimmed snapshot table is what's committed)
data/college_football/raw/
# The soccer outcome model is refit in-run daily; the forest pickle is ~50 MB.
soccer/clubs/model/artifacts/outcome_model.pkl

# Research harness caches (rebuilt on demand; the soccer one replays ~59k matches).
research/.cache/
